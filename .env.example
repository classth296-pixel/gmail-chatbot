# Copy this to .env and fill in your values.

GOOGLE_API_KEY=your_google_generative_ai_api_key
EMBEDDING_MODEL=models/gemini-embedding-001
CHAT_MODEL=gemini-3.1-flash-lite

# Must exactly match a redirect URI registered on your Google Cloud OAuth
# "Web application" client. For local dev, leave as-is. In production, set
# this to your real domain / EC2 public address, e.g.
# REDIRECT_URI=http://your-ec2-public-ip/api/oauth/callback
REDIRECT_URI=http://localhost:8000/api/oauth/callback

USERS_DIR=users
SESSION_SECRET=change-me-to-something-random
DEFAULT_USER_ID=manoj

MAX_FETCH_RESULTS=100
EMBED_BATCH_SIZE=10
RETRIEVER_K=5

HOST=0.0.0.0
PORT=8000
